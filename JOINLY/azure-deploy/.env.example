# Required: secret key callers must send as X-API-Key header to use this API
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MANAGER_API_KEY=

AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=joinly-rg
AZURE_LOCATION=eastus
AZURE_CONTAINER_ENV_NAME=joinly-env
AZURE_REGISTRY_NAME=joinlyreg
JOINLY_LLM_PROVIDER=anthropic
JOINLY_LLM_MODEL=claude-sonnet-4-6
# Note: do NOT set ANTHROPIC_API_KEY here — callers supply their own key per request

# Azure File Share — shared Chromium browser profile (Approach 3, optional)
# Run azure-deploy/infra/provision_file_share.sh to create these resources.
# When all three are set, each ACI container mounts the share at /browser-profile.
AZURE_STORAGE_ACCOUNT_NAME=joinlyprofiledev
AZURE_STORAGE_ACCOUNT_KEY=<your-storage-account-key>
AZURE_FILE_SHARE_NAME=browser-profile
