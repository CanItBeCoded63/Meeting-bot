{
    "mcpServers": {
        "global_weather": {
            "command": "cmd",
            "args": ["/c", "npx", "-y", "@dangahagan/weather-mcp"]
        },
        "tavily": {
            "command": "cmd",
            "args": ["/c", "npx", "-y", "tavily-mcp@0.2.2"],
            "env": {
                "TAVILY_API_KEY": "${TAVILY_API_KEY}"
            }
        },
        "notion": {
            "command": "cmd",
            "args": ["/c", "npx", "-y", "@notionhq/notion-mcp-server"],
            "env": {
                "OPENAPI_MCP_HEADERS": "{\"Authorization\": \"Bearer ${NOTION_API_TOKEN}\", \"Notion-Version\": \"2022-06-28\"}"
            }
        }
    }
}
